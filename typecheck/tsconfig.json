{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": { "@/components/Kit/*": ["build/components/Kit/*"], "@kit/ui": ["build/components/Kit/index.ts"] },
    "types": ["vite/client"]
  },
  "include": ["build/**/*.ts", "build/**/*.vue", "fixtures/**/*.vue", "shims.d.ts", "../types/kit.d.ts"]
}
