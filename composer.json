{
    "name": "tey/kit",
    "description": "Feature kit for tenant-aware Laravel apps, built for the Tey Labs fleet.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "~8.4.0 || ~8.5.0",
        "composer/semver": "^3.4",
        "glhd/gretel": "^1.10",
        "illuminate/support": "^13.0",
        "inertiaui/modal": "^3.1",
        "lorisleiva/laravel-actions": "^2.12",
        "spatie/laravel-data": "^4.23",
        "spatie/laravel-medialibrary": "^11.13",
        "spatie/laravel-query-builder": "^7.3",
        "tey/mod": "^0.11"
    },
    "require-dev": {
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/fortify": "^1.41",
        "laravel/framework": "^13.0",
        "laravel/mcp": "^1.0",
        "laravel/passport": "^13.10",
        "laravel/pennant": "^1.0",
        "spatie/laravel-multitenancy": "^4.2",
        "spatie/laravel-settings": "^3.9",
        "spatie/laravel-typescript-transformer": "^3.3",
        "tey/concierge": "^0.8.2"
    },
    "autoload": {
        "psr-4": {
            "Tey\\Kit\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tey\\Kit\\KitServiceProvider",
                "Tey\\Kit\\Features\\FeaturesServiceProvider"
            ]
        }
    },
    "scripts": {
        "test:scaffold": "@php tests/ScaffoldCheck.php vendor/autoload.php",
        "test:features": "@php tests/FeatureCheck.php vendor/autoload.php",
        "test:catalog": "@php tests/CatalogCheck.php vendor/autoload.php",
        "test:lifecycle": "@php tests/LifecycleCheck.php vendor/autoload.php",
        "test:status": "@php tests/StatusCheck.php vendor/autoload.php",
        "test:typescript": "@php tests/TypeScriptCheck.php vendor/autoload.php",
        "test:resources": "@php tests/ResourceCheck.php vendor/autoload.php",
        "test:library": "@php tests/LibraryCheck.php vendor/autoload.php",
        "test:starter-catalog": "@php tests/StarterCatalogCheck.php vendor/autoload.php",
        "test:adopt": "@php tests/AdoptCheck.php vendor/autoload.php",
        "test:adopt-in-place": "@php tests/AdoptInPlaceCheck.php vendor/autoload.php",
        "test:permissions": "@php tests/PermissionsCheck.php vendor/autoload.php",
        "test:permissions-http": "@php tests/PermissionsHttpCheck.php vendor/autoload.php",
        "test:mcp-refresh": "@php tests/McpRefreshCheck.php vendor/autoload.php",
        "test:workspace-guard": "@php tests/WorkspaceGuardCheck.php vendor/autoload.php",
        "test:capability-guard": "@php tests/CapabilityGuardCheck.php vendor/autoload.php",
        "test:capability-tool": "@php tests/CapabilityToolCheck.php vendor/autoload.php",
        "test:entitlements": "@php tests/EntitlementsCheck.php vendor/autoload.php",
        "test:install": "@php tests/InstallCheck.php vendor/autoload.php",
        "test:fonts": "@php tests/FontsCheck.php vendor/autoload.php",
        "test:tables": "@php tests/TableQueryCheck.php vendor/autoload.php",
        "test:lists": "@php tests/ScrollListCheck.php vendor/autoload.php",
        "test:shell": "@php tests/ShellCheck.php vendor/autoload.php",
        "test:mail": "@php tests/FluentMailCheck.php vendor/autoload.php",
        "test:brand": "@php tests/BrandVariantsCheck.php",
        "test:environment": "@php tests/EnvironmentIndicatorCheck.php",
        "test:input-select": "node --test tests/js/input-select.test.mjs",
        "test:explanation": [
            "@php tests/ExplanationCheck.php vendor/autoload.php",
            "node --test tests/explanation/working.test.mjs"
        ],
        "test:js": "node --test tests/js/number.test.mjs tests/js/actions.test.mjs tests/js/menu.test.mjs tests/js/locked.test.mjs",
        "test:split-drop": "node --test tests/js/split-drop.test.mjs",
        "test:greeting": "@php tests/DashboardGreetingCheck.php vendor/autoload.php",
        "test:table-count": "node --test tests/js/datatable-count.test.mjs",
        "test:stubs": "node --test tests/js/stubs-parse.test.mjs",
        "test:popover": "node --test tests/js/popover.test.mjs"
    },
    "config": {
        "sort-packages": true
    }
}
