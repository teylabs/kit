{
    "name": "tey/kit",
    "description": "Feature kit for tenant-aware Laravel apps, built for the Tey Labs fleet.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "~8.4.0 || ~8.5.0",
        "composer/semver": "^3.4",
        "glhd/gretel": "^1.10",
        "illuminate/support": "^13.0",
        "inertiaui/modal": "^3.1",
        "lorisleiva/laravel-actions": "^2.12",
        "spatie/laravel-data": "^4.23",
        "spatie/laravel-medialibrary": "^11.13",
        "spatie/laravel-query-builder": "^7.3",
        "tey/mod": "^0.11"
    },
    "require-dev": {
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/fortify": "^1.41",
        "laravel/framework": "^13.0",
        "laravel/mcp": "^1.0",
        "laravel/passport": "^13.10",
        "laravel/pennant": "^1.0",
        "laravel/pint": "^1.32",
        "phpstan/phpstan": "^2.1",
        "spatie/laravel-multitenancy": "^4.2",
        "spatie/laravel-settings": "^3.9",
        "spatie/laravel-typescript-transformer": "^3.3",
        "tey/concierge": "^0.8.4",
        "tey/standards": "^0.11.50"
    },
    "autoload": {
        "psr-4": {
            "Tey\\Kit\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tey\\Kit\\KitServiceProvider",
                "Tey\\Kit\\Features\\FeaturesServiceProvider"
            ]
        }
    },
    "scripts": {
        "test:scaffold": "@php tests/ScaffoldCheck.php vendor/autoload.php",
        "test:features": "@php tests/FeatureCheck.php vendor/autoload.php",
        "test:catalog": "@php tests/CatalogCheck.php vendor/autoload.php",
        "test:lifecycle": "@php tests/LifecycleCheck.php vendor/autoload.php",
        "test:pint-stubs": "sh bin/pint-stubs.sh",
        "test:kit-types": "@php bin/kit-types.php --check",
        "test:host-contract": "phpstan analyse -c tests/phpstan/host-contract.neon --no-progress --memory-limit=512M",
        "test:status": "@php tests/StatusCheck.php vendor/autoload.php",
        "test:typescript": "@php tests/TypeScriptCheck.php vendor/autoload.php",
        "test:viewmodel-order": "@php tests/ViewModelOrderCheck.php vendor/autoload.php",
        "test:resources": "@php tests/ResourceCheck.php vendor/autoload.php",
        "test:library": "@php tests/LibraryCheck.php vendor/autoload.php",
        "test:starter-catalog": "@php tests/StarterCatalogCheck.php vendor/autoload.php",
        "test:adopt": "@php tests/AdoptCheck.php vendor/autoload.php",
        "test:plan-steps": "@php tests/PlanStepsCheck.php vendor/autoload.php",
        "test:add-refused": "@php tests/AddRefusedCheck.php vendor/autoload.php",
        "test:operators-seed": "@php tests/OperatorsSeedCheck.php vendor/autoload.php",
        "test:adopt-in-place": "@php tests/AdoptInPlaceCheck.php vendor/autoload.php",
        "test:starter-case": "@php tests/StarterCaseCheck.php vendor/autoload.php",
        "test:permissions": "@php tests/PermissionsCheck.php vendor/autoload.php",
        "test:permissions-http": "@php tests/PermissionsHttpCheck.php vendor/autoload.php",
        "test:mcp-refresh": "@php tests/McpRefreshCheck.php vendor/autoload.php",
        "test:mcp-server-config": "@php tests/McpServerConfigCheck.php vendor/autoload.php",
        "test:host-boot": "@php tests/HostBootCheck.php vendor/autoload.php",
        "test:mcp-consent": "@php tests/McpConsentCheck.php vendor/autoload.php",
        "test:mcp-authorize": "@php tests/McpAuthorizeCheck.php vendor/autoload.php",
        "test:mcp-host-consent": "@php tests/McpHostConsentCheck.php vendor/autoload.php",
        "test:workspace-guard": "@php tests/WorkspaceGuardCheck.php vendor/autoload.php",
        "test:typed-confirmation": "@php tests/TypedConfirmationCheck.php vendor/autoload.php",
        "test:tenant-tasks": "@php tests/TenantSwitchTasksCheck.php vendor/autoload.php",
        "test:capability-guard": "@php tests/CapabilityGuardCheck.php vendor/autoload.php",
        "test:capability-tool": "@php tests/CapabilityToolCheck.php vendor/autoload.php",
        "test:entitlements": "@php tests/EntitlementsCheck.php vendor/autoload.php",
        "test:install": ["Composer\\Config::disableProcessTimeout", "@php tests/InstallCheck.php vendor/autoload.php"],
        "test:onboarding": "@php tests/OnboardingCheck.php vendor/autoload.php",
        "test:onboarding-js": "node --test tests/js/onboarding.test.mjs",
        "test:auth-only": "@php tests/AuthOnlyCheck.php vendor/autoload.php",
        "test:workspace-ui": ["Composer\\Config::disableProcessTimeout", "@php tests/WorkspaceUiCheck.php vendor/autoload.php"],
        "test:session-ui-core": "@php tests/SessionUiCoreCheck.php vendor/autoload.php",
        "test:inertia-shares": "@php tests/InertiaSharesCheck.php vendor/autoload.php",
        "test:request-hooks": "@php tests/RequestHooksCheck.php vendor/autoload.php",
        "test:request-order": "@php tests/RequestOrderCheck.php vendor/autoload.php",
        "test:layout": ["Composer\\Config::disableProcessTimeout", "@php tests/LayoutCheck.php vendor/autoload.php"],
        "test:fonts": "@php tests/FontsCheck.php vendor/autoload.php",
        "test:tables": "@php tests/TableQueryCheck.php vendor/autoload.php",
        "test:lists": "@php tests/ScrollListCheck.php vendor/autoload.php",
        "test:shell": "@php tests/ShellCheck.php vendor/autoload.php",
        "test:public-shell": "@php tests/PublicShellCheck.php vendor/autoload.php",
        "test:mail": "@php tests/FluentMailCheck.php vendor/autoload.php",
        "test:mail-escape": "@php tests/MailEscapeCheck.php vendor/autoload.php",
        "test:conflict-markers": "@php tests/ConflictMarkersCheck.php",
        "test:brand": "@php tests/BrandVariantsCheck.php",
        "test:environment": "@php tests/EnvironmentIndicatorCheck.php",
        "test:input-select": "node --test tests/js/input-select.test.mjs",
        "test:iso-date": "@php tests/IsoDateCheck.php vendor/autoload.php",
        "test:explanation": [
            "@php tests/ExplanationCheck.php vendor/autoload.php",
            "node --test tests/explanation/working.test.mjs"
        ],
        "test:js": "node --test 'tests/js/*.test.mjs'",
        "test:split-drop": "node --test tests/js/split-drop.test.mjs",
        "test:workbench": "@php tests/WorkbenchCheck.php vendor/autoload.php",
        "test:workbench-js": "node --test tests/js/workbench.test.mjs",
        "test:workbench-item-parity": "@php tests/WorkbenchItemParityCheck.php vendor/autoload.php",
        "test:greeting": "@php tests/DashboardGreetingCheck.php vendor/autoload.php",
        "test:dashboard": "@php tests/DashboardWidgetsCheck.php vendor/autoload.php",
        "test:search": "@php tests/SearchCheck.php vendor/autoload.php",
        "test:workspace-models": "@php tests/WorkspaceModelCheck.php vendor/autoload.php",
        "test:workspace-adopt": "@php tests/WorkspaceAdoptCheck.php vendor/autoload.php",
        "test:audit-workspace-fk": "@php tests/AuditWorkspaceFkCheck.php vendor/autoload.php",
        "test:adopt-fresh": "@php tests/AdoptFreshCheck.php vendor/autoload.php",
        "test:search-js": "node --test tests/js/search.test.mjs",
        "test:notes": "@php tests/NotesCheck.php vendor/autoload.php",
        "test:lifecycle-pages": "@php tests/LifecyclePagesCheck.php vendor/autoload.php",
        "test:media-uploads": "@php tests/MediaUploadCheck.php vendor/autoload.php",
        "test:media-conversions": "@php tests/MediaConversionsCheck.php vendor/autoload.php",
        "test:media-delivery": "@php tests/MediaDeliveryCheck.php vendor/autoload.php",
        "test:media-adopt": "@php tests/MediaAdoptCheck.php vendor/autoload.php",
        "test:toast": "@php tests/ToastCheck.php vendor/autoload.php",
        "test:table-count": "node --test tests/js/datatable-count.test.mjs tests/js/table-selection.test.mjs",
        "test:stubs": "node --test tests/js/stubs-parse.test.mjs tests/js/select-conventions.test.mjs tests/js/style-conventions.test.mjs",
        "test:popover": "node --test tests/js/popover.test.mjs",
        "test:changelog-guard": "@php tests/ChangelogGuardCheck.php",
        "test:adoption-fixtures": "@php tests/AdoptionFixturesCheck.php",
        "test:adoption-schema": "@php tests/AdoptionSchemaCheck.php vendor/autoload.php",
        "test:catalog-history": "@php tests/CatalogHistoryCheck.php"
    },
    "config": {
        "sort-packages": true
    }
}
