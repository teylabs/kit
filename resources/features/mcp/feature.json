{
  "format": 1,
  "id": "mcp",
  "owns": [
    "resources/js/pages/Workspace/Settings/Connections",
    "database/migrations/kit/mcp"
  ],
  "files": {
    "resources/js/pages/Workspace/Settings/Connections/Page.vue": {
      "stub": "pages/Workspace/Settings/Connections/Page.vue.stub",
      "scaffold": "kit",
      "ownership": "generated"
    }
  },
  "files_from": {
    "stubs": "migrations",
    "target": "database/migrations/kit/mcp"
  },
  "requires": {
    "features": [
      "workspaces",
      "access"
    ],
    "packages": {
      "inertiajs/inertia-laravel": "^3.0",
      "laravel/mcp": "^1.0",
      "laravel/passport": "^13.10",
      "lorisleiva/laravel-actions": "^2.12",
      "spatie/laravel-data": "^4.23"
    }
  },
  "conflicts": [],
  "host_owned": [],
  "host_steps": {
    "env": [
      {
        "key": "PASSPORT_PRIVATE_KEY",
        "why": "MCP connections are Passport tokens. Set the signing key as a PEM, a PEM with \\n escapes or base64, or leave it unset and keep the storage/oauth-private.key that php artisan passport:keys writes."
      },
      {
        "key": "PASSPORT_PUBLIC_KEY",
        "why": "The public half of the Passport signing key, in the same form, or storage/oauth-public.key from php artisan passport:keys."
      }
    ],
    "schedule": [
      {
        "command": "model:prune --model=Tey\\Kit\\Features\\Mcp\\Models\\McpIntent",
        "why": "Stored MCP intents expire after kit.mcp.intent_ttl; without the prune their rows stay."
      }
    ]
  }
}
