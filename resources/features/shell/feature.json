    "mention": [
      {
        "file": "resources/js/app.ts",
        "contains": "pages/Workspace/Partials/PublicShell",
        "why": "the kit's public pages (Public/Markdown/Page) and a guest's error page (Workspace/Error/Page) can use the PublicShell: have your layout callback import the kit's PublicShell (@/pages/Workspace/Partials/PublicShell.vue) and return it for them (docs/public-shell.md). Without it they keep the GuestShell."
      },
      {
        "file": "vite.config.ts",
        "contains": "@kit/shell",
        "why": "the shell's Layout imports UserMenu and WorkspaceSwitcher through the @kit/shell alias, so the build fails without it. Add it beside @kit/ui: resolve: { alias: { '@kit/shell': path.resolve(__dirname, 'resources/js/pages/Workspace/Partials/index.ts') } }"
      },
      {
        "file": "vite.config.ts",
        "contains": "@kit/ui",
        "why": "the shell's pages import the kit's components through the @kit/ui alias, so the build fails without it. Add it to resolve.alias: '@kit/ui': path.resolve(__dirname, 'resources/js/components/Kit/index.ts'). If you point it at your own module instead, that module must export every name the kit's pages import (the README lists them; mcp's Authorize page uses InputSelect)"
      },
      {
        "file": "tsconfig.json",
        "contains": "@kit/shell",
        "why": "vue-tsc resolves the shell's @kit/shell import through tsconfig paths. Add it in compilerOptions beside @kit/ui: \"paths\": { \"@kit/shell\": [\"./resources/js/pages/Workspace/Partials/index.ts\"] }"
      },
      {
        "file": "tsconfig.json",
        "contains": "@kit/ui",
        "why": "vue-tsc resolves the shell's @kit/ui imports through tsconfig paths. Add it in compilerOptions: \"paths\": { \"@kit/ui\": [\"./resources/js/components/Kit/index.ts\"] }"
      },
      {
        "file": "tsconfig.json",
        "contains": "tey/kit/types/kit.d.ts",
        "why": "the kit's pages are typed with its Tey.Kit.* namespaces (Tey.Kit.Features.Shell.Data.ShellData and the rest), which the kit ships, generated, in vendor/tey/kit/types/kit.d.ts. Add it to tsconfig.json's include: \"vendor/tey/kit/types/kit.d.ts\" (or, for defineProps, to @vitejs/plugin-vue's script.globalTypeFiles in your Vite config: either place meets this). It stays in step with the kit you have installed. If your own transformer already writes the Tey.Kit namespaces, leave this out: both would declare each type twice",
        "or_file": "vite.config.ts"
      }
    ]
  }
