<script setup lang="ts">
import { Link, usePage } from '@inertiajs/vue3';
import { ChevronRight, House } from '@lucide/vue';
import { computed } from 'vue';

// The trail to the page, shared by gretel, always shown so the page does not shift: it is rooted at "/", which shows as a home icon
// named by the workspace (or the product, with one workspace). The Dashboard, Settings and the personal pages are its siblings.
type Crumb = { title: string; url: string; is_current_page: boolean };
const page = usePage<{ breadcrumbs?: Crumb[] }>();
const breadcrumbs = computed(() => page.props.breadcrumbs ?? []);
</script>
<template>
    <nav aria-label="Breadcrumb" class="mb-4 min-h-6" data-shell-breadcrumbs>
        <ol v-if="breadcrumbs.length" class="flex flex-wrap items-center gap-1 text-sm text-muted-foreground">
            <li v-for="(crumb, index) in breadcrumbs" :key="crumb.url" class="flex items-center gap-1">
                <ChevronRight v-if="index > 0" class="size-3.5" aria-hidden="true" />
                <template v-if="index === 0">
                    <span v-if="crumb.is_current_page" aria-current="page" :aria-label="crumb.title" class="inline-flex size-6 items-center justify-center text-foreground" data-breadcrumb-home><House class="size-4" aria-hidden="true" /></span>
                    <Link v-else :href="crumb.url" :aria-label="crumb.title" class="inline-flex size-6 items-center justify-center rounded-md hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none" data-breadcrumb-home><House class="size-4" aria-hidden="true" /></Link>
                </template>
                <Link v-else-if="!crumb.is_current_page" :href="crumb.url" class="hover:text-foreground hover:underline">{{ crumb.title }}</Link>
                <span v-else aria-current="page" class="text-foreground">{{ crumb.title }}</span>
            </li>
        </ol>
    </nav>
</template>
