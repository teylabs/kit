{
  "format": 1,
  "id": "core",
  "owns": [
    "database/migrations/kit/core",
    "resources/css/kit.css"
  ],
  "files": {
    "resources/css/kit.css": {
      "stub": "css/kit.css.stub",
      "scaffold": "kit",
      "ownership": "generated"
    }
  },
  "files_from": {
    "stubs": "migrations",
    "target": "database/migrations/kit/core"
  },
  "requires": {
    "features": [],
    "packages": {
      "laravel/framework": "^13.17",
      "php": "~8.4.0 || ~8.5.0"
    },
    "npm": {
      "@inertiajs/vue3": "^3.0",
      "@inertiaui/modal-vue": "^3.1.2",
      "@internationalized/date": "^3.5.0",
      "@lucide/vue": "^1.0.0",
      "@tanstack/vue-table": "^8.0.0",
      "@tiptap/core": "^3.32.0",
      "@tiptap/extension-code": "^3.32.0",
      "@tiptap/extension-placeholder": "^3.32.0",
      "@tiptap/extension-text-align": "^3.32.0",
      "@tiptap/extension-text-style": "^3.32.0",
      "@tiptap/pm": "^3.32.0",
      "@tiptap/starter-kit": "^3.32.0",
      "@tiptap/vue-3": "^3.32.0",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "reka-ui": ">=2.11.0",
      "tailwind-merge": "^3.0.0",
      "tw-animate-css": "^1.4.0",
      "vue-draggable-plus": "^0.6.1",
      "vue-sonner": "^2.0.0"
    },
    "host_ui": [
      "button",
      "checkbox",
      "dropdown-menu",
      "input",
      "label",
      "sheet",
      "spinner/Spinner.vue"
    ]
  },
  "host_steps": {
    "theme": [
      {
        "file": "resources/css/app.css",
        "why": "the kit's components are coloured with shadcn-vue's semantic tokens (bg-primary, text-muted-foreground, border-input…)"
      }
    ]
  },
  "conflicts": [],
  "host_owned": [
    "app/Models/User.php",
    "bootstrap",
    "routes/web.php",
    "routes/api.php",
    "routes/console.php",
    "config",
    "app/Domain",
    "database/seeders",
    "package.json",
    "vite.config.ts",
    ".env",
    ".env.example",
    "resources/css/app.css",
    "composer.json",
    "resources/js/components/ui"
  ],
  "optional": [
    {
      "id": "explanation-types",
      "title": "Typed Explanation props",
      "do": "Register Tey\\Kit\\TypeScript\\ExplanationTypesExtension in the typescript-transformer config ($config->extension(new ExplanationTypesExtension)), so page props carrying an Explanation are typed instead of undefined."
    }
  ]
}
