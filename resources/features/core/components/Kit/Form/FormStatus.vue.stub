<script setup lang="ts">
import { router, usePage } from '@inertiajs/vue3';
import { computed, onBeforeUnmount, onMounted, ref, watch } from 'vue';
import Alert from '@/components/Kit/Feedback/Alert.vue';
import type { AlertVariant } from '@/components/Kit/Feedback/alertVariants';

/*
 * A form's persistent confirmation after a submit ("we emailed you a link", "you're on the list"): an Alert with `live="status"` (a polite announcement), not a toast,
 * so it never times out. The text is `message` when given (null shows nothing), otherwise the flashed `status` page prop (Fortify's convention, through the view model).
 *
 * It stays until the next submit or visit: the router's `start` hides it, as does `form.processing` (a useForm() result); the visit's `finish` lets it show again, so
 * it returns only when the new response still carries a status. Rendering the Alert afresh each time makes the live region announce it again. Nothing when empty.
 */
type FormStatusTone = 'success' | 'info' | 'warning';

const props = withDefaults(defineProps<{ message?: string | null; tone?: FormStatusTone; form?: { processing: boolean } | null }>(), { message: undefined, tone: 'success', form: null });

const variants: Record<FormStatusTone, AlertVariant> = { success: 'success', info: 'info', warning: 'warning' };
const variant = computed<AlertVariant>(() => variants[props.tone] ?? 'success');

const page = usePage();
const text = computed(() => {
    const value = props.message !== undefined ? props.message : (page.props as { status?: unknown }).status;
    return typeof value === 'string' && value.trim() !== '' ? value : null;
});

const hidden = ref(false);
watch(() => props.form?.processing, (processing) => {
    if (processing) hidden.value = true;
});
let offStart: (() => void) | undefined;
let offFinish: (() => void) | undefined;
onMounted(() => {
    offStart = router.on('start', () => {
        hidden.value = true;
    });
    offFinish = router.on('finish', () => {
        hidden.value = false;
    });
});
onBeforeUnmount(() => {
    offStart?.();
    offFinish?.();
});
</script>
<template>
    <Alert v-if="text !== null && !hidden" :variant="variant" live="status" data-slot="form-status">{{ text }}</Alert>
</template>
