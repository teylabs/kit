<script setup lang="ts">
import { computed, ref } from 'vue';
import { createCommitter } from './radioCommit';

export type RadioCardOption = { value: string | number; label: string; description?: string | null; disabled?: boolean; result?: number | null };

/*
 * Large tappable choices (a poll's options on a phone): each option is a card around a native radio, so the browser gives the group one tab stop and the arrow keys
 * move and select within it (the radio group's roving tabindex), and the value submits with a plain or Inertia <Form> under `name`. The group is a
 * `role="radiogroup"` named by its Field's label (`<id>-label`) or `label`, and described by the Field's description and error. `v-model` is the selected value.
 * A selected card takes the primary ring; a disabled option (or a `disabled` group) is dimmed and skipped. `result` (0 to 100) draws a result bar and percentage
 * under the label once results are shown (`showResults`), or the `result` slot replaces it. Utilities and tokens only.
 *
 * `commit="click"` (a live poll, where a vote is sent at once) deviates from the APG radio group on purpose: the arrow keys, Home and End only move focus (a
 * roving tabindex over `role="radio"` buttons), and nothing is chosen until Space, Enter, a click or a tap. That press sets `v-model` and emits `commit`; pressing
 * the option already chosen emits nothing. The choice is announced politely, and a hidden input still submits it under `name`. The default, `change`, is the
 * native group above, where arrowing selects. Each card carries `data-value` (the option's value): a hook for browser tests and styling.
 */
const props = withDefaults(defineProps<{ id: string; name?: string; options: RadioCardOption[]; label?: string; disabled?: boolean; showResults?: boolean; commit?: 'change' | 'click' }>(), { name: undefined, label: undefined, disabled: false, showResults: false, commit: 'change' });
const emit = defineEmits<{ commit: [value: string | number] }>();
const model = defineModel<string | number | null>({ default: null });
const groupName = computed(() => props.name ?? props.id);
const optionId = (index: number) => `${props.id}-option-${index}`;
const clickMode = computed(() => props.commit === 'click');
// commit="click": the focused card (the one tab stop), the buttons to move focus between, and the polite announcement of the committed choice.
const focused = ref(Math.max(0, props.options.findIndex(option => option.value === model.value)));
const cards = ref<HTMLElement[]>([]);
const announced = ref('');
const committer = createCommitter({
    options: () => props.options,
    disabled: () => props.disabled,
    value: () => model.value,
    commit: (value, label) => {
        model.value = value;
        emit('commit', value);
        announced.value = `${label} chosen`;
    },
    focus: index => {
        focused.value = index;
        cards.value[index]?.focus();
    },
});
function move(event: KeyboardEvent, index: number): void {
    if (committer.key(event.key, index)) event.preventDefault();
}
const percent = (option: RadioCardOption) => Math.max(0, Math.min(100, Math.round(option.result ?? 0)));
</script>
<template>
    <div :id="id" role="radiogroup" :aria-label="label" :aria-labelledby="label ? undefined : `${id}-label`" :aria-describedby="`${id}-description ${id}-error`" :aria-disabled="disabled || undefined" class="grid gap-3" data-radio-card-group>
        <component
            :is="clickMode ? 'button' : 'label'"
            v-for="(option, index) in options"
            :key="option.value"
            :ref="(el: unknown) => { if (clickMode && el) cards[index] = el as HTMLElement }"
            :for="clickMode ? undefined : optionId(index)"
            :type="clickMode ? 'button' : undefined"
            :role="clickMode ? 'radio' : undefined"
            :aria-checked="clickMode ? (model === option.value ? 'true' : 'false') : undefined"
            :aria-disabled="clickMode && (disabled || option.disabled) ? 'true' : undefined"
            :tabindex="clickMode ? (index === focused ? 0 : -1) : undefined"
            :aria-describedby="clickMode && option.description ? `${optionId(index)}-description` : undefined"
            :class="[
                'relative grid min-h-14 gap-1 rounded-xl border bg-card p-4 text-left text-card-foreground transition-colors motion-reduce:transition-none',
                'has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-ring focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring',
                model === option.value ? 'border-primary ring-2 ring-primary' : 'border-border',
                disabled || option.disabled ? 'cursor-not-allowed opacity-50' : 'cursor-pointer hover:bg-accent/50',
            ]"
            :data-selected="model === option.value || undefined"
            :data-disabled="disabled || option.disabled || undefined"
            :data-value="String(option.value)"
            data-radio-card
            @click="clickMode && committer.press(index)"
            @keydown="clickMode && move($event, index)"
        >
            <input v-if="!clickMode" :id="optionId(index)" v-model="model" type="radio" class="sr-only" :name="groupName" :value="option.value" :disabled="disabled || option.disabled" :aria-describedby="option.description ? `${optionId(index)}-description` : undefined" />
            <span class="flex items-center gap-3">
                <span :class="['flex size-5 shrink-0 items-center justify-center rounded-full border-2', model === option.value ? 'border-primary' : 'border-muted-foreground']" aria-hidden="true">
                    <span v-if="model === option.value" class="size-2.5 rounded-full bg-primary" />
                </span>
                <span class="min-w-0 text-base font-medium break-words">{{ option.label }}</span>
            </span>
            <span v-if="option.description" :id="`${optionId(index)}-description`" class="pl-8 text-sm text-muted-foreground">{{ option.description }}</span>
            <slot v-if="showResults" name="result" :option="option" :selected="model === option.value" :percent="percent(option)">
                <span class="flex items-center gap-3 pl-8" data-radio-card-result>
                    <span class="h-2 min-w-0 flex-1 overflow-hidden rounded-full bg-muted" aria-hidden="true">
                        <span class="block h-full w-(--kit-radio-result) rounded-full bg-primary transition-[width] duration-500 motion-reduce:transition-none" :style="{ '--kit-radio-result': `${percent(option)}%` }" />
                    </span>
                    <span class="w-12 shrink-0 text-right text-sm tabular-nums text-muted-foreground">{{ percent(option) }}%</span>
                </span>
            </slot>
        </component>
        <template v-if="clickMode">
            <input type="hidden" :name="groupName" :value="model ?? ''" data-radio-card-value />
            <p role="status" class="sr-only" data-radio-card-announce>{{ announced }}</p>
        </template>
    </div>
</template>
