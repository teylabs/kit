<script setup lang="ts">
import { useFormContext } from '@inertiajs/vue3';
import { computed } from 'vue';
import { Button as BaseButton } from '@/components/ui/button';
import { inverseControl, inverseFilled, pillControl, useSurface } from '@/components/Kit/Surface/surface';
import { insideFormSubmit } from './formSubmit';

// The buttons a form and a toolbar need: primary, secondary and destructive, `ghost` and `link` (the host button's own ghost and link), and `bar`: a ghost for
// controls ON the shell's header bar, drawn from `--shell-bar-foreground` so it reads on a dark bar too. No variant needs anything new in the host button.
// `size` is the host button's: default, sm or icon. `type` defaults to `submit` only inside a form that submits it (Inertia's <Form> or a FormCard) and to
// `button` everywhere else, so a toolbar or menu button never submits a form by accident; pass `type` to say otherwise.
// On a surface (FloatingToolbar's pill, a Surface) it takes that surface's shape and tone; elsewhere the shared radius and tones hold.
const props = withDefaults(defineProps<{ variant?: 'primary' | 'secondary' | 'destructive' | 'ghost' | 'link' | 'bar'; size?: 'default' | 'sm' | 'icon'; type?: 'submit' | 'button' }>(), { variant: 'primary', size: 'default', type: undefined });
const base = computed(() => (props.variant === 'primary' ? 'default' : props.variant === 'bar' ? 'ghost' : props.variant));
const inForm = Boolean(useFormContext()) || insideFormSubmit();
const kind = computed(() => props.type ?? (inForm ? 'submit' : 'button'));
const barClass = 'text-[color:var(--shell-bar-foreground)] hover:bg-[color:var(--shell-bar-foreground)]/10 hover:text-[color:var(--shell-bar-foreground)]';
const surface = useSurface();
const blend = computed(() => [
    props.variant === 'bar' && barClass,
    surface.value.shape === 'pill' && pillControl,
    surface.value.tone === 'inverse' && (props.variant === 'primary' ? inverseFilled : inverseControl),
]);
</script>
<template>
    <BaseButton :variant="base" :size="size" :type="kind" :class="blend"><slot /></BaseButton>
</template>
