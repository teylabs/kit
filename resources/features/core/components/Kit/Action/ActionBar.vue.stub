<script setup lang="ts">
import { Link } from '@inertiajs/vue3';
import { ModalLink } from '@inertiaui/modal-vue';
import { ChevronDown } from '@lucide/vue';
import { computed } from 'vue';
import { DropdownMenu, DropdownMenuContent, DropdownMenuItem, DropdownMenuTrigger } from '@/components/ui/dropdown-menu';
import ActionLabel from '@/components/Kit/Action/ActionLabel.vue';
import { actionIcons } from '@/components/Kit/Action/actionIcons';
import { actionIconName, isNavigation, layoutActions, placeActions, type ActionDescriptor } from '@/components/Kit/Action/actionPlacement';
import Toolbar from '@/components/Kit/Layout/Toolbar.vue';
import { inverseControl, inverseFilled, useSurface } from '@/components/Kit/Surface/surface';

/*
 * Server action descriptors as button groups. With declared `group`s each group (or a standalone action) is one segmented group, its `menu` actions behind a ⌄;
 * without, the placement rule decides. Dialog intent opens the route modal, document intent a new tab, ordinary GETs navigate; every other action is emitted for
 * the host to run (confirmation included). Nothing here checks a permission. `busy` blocks all but a standalone document link; `dialogOpen` holds menu focus for the
 * dialog the host opens. On an inverse pill surface (FloatingToolbar) the segments take its tone and shape.
 */
const props = withDefaults(defineProps<{ actions: ActionDescriptor[]; busy?: boolean; dialogOpen?: boolean; primary?: boolean }>(), { busy: false, dialogOpen: false, primary: false });
const emit = defineEmits<{ action: [action: ActionDescriptor] }>();
const surface = useSurface();
const parts = computed(() => layoutActions(props.actions)?.map(part => (part.kind === 'group' ? part : { key: part.key, inline: [part.action], menu: [] as ActionDescriptor[] }))
    ?? [{ key: 'actions', ...placeActions(props.actions) }]);
const pill = computed(() => surface.value.shape === 'pill');
const inverse = computed(() => surface.value.tone === 'inverse');
const group = computed(() => ['inline-flex isolate min-w-0 [&>*+*]:-ml-px', pill.value ? '[&>*:first-child]:rounded-l-full [&>*:last-child]:rounded-r-full' : '[&>*:first-child]:rounded-l-md [&>*:last-child]:rounded-r-md']);
function segment(filled: boolean): string[] {
    return [
        'inline-flex min-w-0 shrink items-center justify-center rounded-none text-sm font-medium whitespace-nowrap no-underline transition-colors focus-visible:z-10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring disabled:pointer-events-none disabled:opacity-50',
        pill.value ? 'h-9 px-3.5' : 'h-9 px-3',
        inverse.value ? (filled ? `${inverseFilled} [&+*]:border-l [&+*]:border-primary-foreground/25` : inverseControl)
            : filled ? 'bg-primary text-primary-foreground shadow-xs hover:bg-primary/90' : 'border border-input bg-background shadow-xs hover:bg-accent hover:text-accent-foreground dark:bg-input/30 dark:hover:bg-input/50',
    ];
}
const filled = (index: number) => props.primary && index === 0;
const menuIcon = (action: ActionDescriptor) => actionIcons[actionIconName(action, true) ?? ''];
// The menu closes and gives focus back first; opened in the same tick, the menu's own dismissal would swallow the host's confirmation.
const select = (action: ActionDescriptor) => setTimeout(() => emit('action', action), 0);
const holdFocus = (event: Event) => { if (props.dialogOpen) event.preventDefault(); };
</script>
<template>
    <Toolbar v-if="actions.length" data-action-bar>
        <div v-for="part in parts" :key="part.key" role="group" :class="group" data-action-group :data-action-layout="part.key">
            <template v-for="(action, index) in part.inline" :key="action.key ?? action.url">
                <ModalLink v-if="action.intent === 'dialog' && !action.disabled && !busy" :href="action.url" navigate :class="segment(filled(index))" :data-action="action.key"><ActionLabel :action="action" /></ModalLink>
                <a v-else-if="action.intent === 'document' && !action.disabled" :href="action.url" target="_blank" rel="noopener noreferrer" :class="segment(filled(index))" :data-action="action.key"><ActionLabel :action="action" /></a>
                <Link v-else-if="isNavigation(action) && !action.disabled && !busy" :href="action.url" :class="segment(filled(index))" :data-action="action.key"><ActionLabel :action="action" /></Link>
                <button v-else type="button" :disabled="busy || action.disabled" :title="action.reason ?? undefined" :class="segment(filled(index))" :data-action="action.key" @click="emit('action', action)"><ActionLabel :action="action" /></button>
            </template>
            <DropdownMenu v-if="part.menu.length">
                <DropdownMenuTrigger as-child>
                    <button type="button" :class="[segment(false), pill ? 'px-2.5' : 'px-2']" :aria-label="part.inline.length ? `More actions: ${part.inline[0].label}` : 'More actions'" data-action-menu><ChevronDown class="size-4" aria-hidden="true" /></button>
                </DropdownMenuTrigger>
                <DropdownMenuContent align="end" @close-auto-focus="holdFocus">
                    <template v-for="action in part.menu" :key="action.key ?? action.url">
                        <DropdownMenuItem v-if="action.intent === 'dialog' && !action.disabled" as-child :disabled="busy" :data-action="action.key">
                            <ModalLink :href="action.url" navigate><component :is="menuIcon(action)" v-if="menuIcon(action)" class="size-4" aria-hidden="true" /><ActionLabel :action="action" menu /></ModalLink>
                        </DropdownMenuItem>
                        <DropdownMenuItem v-else-if="action.intent === 'document' && !action.disabled" as-child :disabled="busy" :data-action="action.key">
                            <a :href="action.url" target="_blank" rel="noopener noreferrer"><component :is="menuIcon(action)" v-if="menuIcon(action)" class="size-4" aria-hidden="true" /><ActionLabel :action="action" menu /></a>
                        </DropdownMenuItem>
                        <DropdownMenuItem v-else :disabled="busy || action.disabled" :class="action.destructive ? 'text-destructive focus:text-destructive' : undefined" :title="action.reason ?? undefined" :data-action="action.key" @select="select(action)">
                            <component :is="menuIcon(action)" v-if="menuIcon(action)" class="size-4" aria-hidden="true" /><ActionLabel :action="action" menu />
                        </DropdownMenuItem>
                    </template>
                </DropdownMenuContent>
            </DropdownMenu>
        </div>
    </Toolbar>
</template>
