<script setup lang="ts">
import { SplitterGroup, SplitterPanel, SplitterResizeHandle } from 'reka-ui';
import { computed, nextTick, onBeforeUnmount, onMounted, ref, useId, watch } from 'vue';
import type { ActionDescriptor } from '@/components/Kit/Action/actionPlacement';
import PaneScroll from '@/components/Kit/Layout/PaneScroll.vue';
import PaneTabs from '@/components/Kit/Layout/PaneTabs.vue';
import PaneToggle from '@/components/Kit/Layout/PaneToggle.vue';
import EmptyState from '@/components/Kit/Feedback/EmptyState.vue';
import Modal from '@/components/Kit/Overlay/Modal.vue';
import { DEFAULT_LABELS, documentEscape, EMPTY_STAGE_TITLE, enabledCommand, isTyping, nextRegion, regionOrder, workbenchMode, workbenchTabs, type WorkbenchEmptySlotProps, type WorkbenchItem, type WorkbenchLabels, type WorkbenchRegion } from './workbench';
import { createLayoutStore, defaultCollapses, type LayoutPreference, type LayoutState } from './workbenchLayout';
import { useWorkbench, type ReorderAction } from './useWorkbench';
import WorkbenchActions from './WorkbenchActions.vue';
import WorkbenchCollapsedBar from './WorkbenchCollapsedBar.vue';
import WorkbenchInspector from './WorkbenchInspector.vue';
import WorkbenchNavigator from './WorkbenchNavigator.vue';
import WorkbenchStage from './WorkbenchStage.vue';

/*
 * A multi-pane editing surface for a sequence of items with a live preview (slides and their blocks, a valuation and its comparables): `navigator` (the items),
 * `stage` (the work, with an optional sticky `toolbar` and an optional resizable `footer` under it), `inspector` (settings for the stage's selection) and an
 * `actions` bar (save state, conflict, zoom, the app's action descriptors) registered with useStickyBars.
 *
 * xl and up: three columns on Reka's Splitter, resizable (keyboard in 5-point steps) and collapsible. lg: navigator and stage, the inspector in a right drawer.
 * Below lg: tabs (Navigator / Stage / Inspector, and the footer's when there is one). Pane sizes, collapsed panes, the zoom and the phone tab are remembered per person
 * and `workbench-key` through `layout` (the server's WorkbenchLayoutData: state, version and the kit's preference endpoint; guarded localStorage without it).
 *
 * A collapsed navigator, inspector or footer keeps a slim bar with its label and Expand button (WorkbenchCollapsedBar).
 * Keys: ↑/↓ or j/k in the navigator, Alt+↑/↓ to move the current item, ⌘[ / ⌘] to collapse the navigator / inspector, `/` for the navigator filter, Esc closes the
 * drawer, else clears the stage elements, else the selection, F6 / Shift+F6 cycle the regions, ⌘+ / ⌘- / ⌘0 zoom. Each region is a labelled landmark. State (selection, inspector, zoom) is useWorkbench(key)'s.
 *
 * With no items yet (useWorkbench().isEmpty) the stage renders the `#empty` slot (`{ actions, act, label }`) in place of `#stage`, or a quiet compact EmptyState.
 *
 * It fills the viewport below the shell (100dvh less 8rem, at least 28rem), so the panes and the stage have a height to resize and fit in; `fill` false leaves it
 * at its content's height, for a Workbench inside a box of a definite height.
 */
const props = withDefaults(defineProps<{
    workbenchKey: string;
    label: string;
    items?: WorkbenchItem[];
    current?: string | null;
    multiple?: boolean;
    labels?: Partial<WorkbenchLabels>;
    layout?: { state: LayoutState | null; preference: LayoutPreference | null } | null;
    reorder?: ReorderAction | null;
    version?: string | number | null;
    actions?: ActionDescriptor[];
    zoom?: boolean;
    canvas?: { width: number; height: number } | null;
    filterable?: boolean;
    fill?: boolean;
    elementAttribute?: string | null;
    keys?: boolean;
    defaultCollapsed?: { navigator?: boolean; inspector?: boolean } | null;
    actionsBar?: boolean;
    headings?: boolean;
    navigatorMode?: 'push' | 'overlay';
    closeOnSelect?: boolean;
    saveStatus?: 'kit' | 'none';
}>(), { saveStatus: 'kit', elementAttribute: null, keys: true, defaultCollapsed: null, actionsBar: true, headings: true, navigatorMode: 'push', closeOnSelect: false, items: () => [], current: null, multiple: true, labels: () => ({}), layout: null, reorder: null, version: null, actions: () => [], zoom: false, canvas: null, filterable: true, fill: true });
const emit = defineEmits<{ action: [action: ActionDescriptor] }>();
const slots = defineSlots<{
    navigator?(): unknown; toolbar?(): unknown; stage?(): unknown; footer?(): unknown; inspector?(): unknown; status?(): unknown; actions?(): unknown;
    /** No items yet: the stage's empty state, with the Workbench's action descriptors and `act` to run one through the `action` event. */
    empty?(props: WorkbenchEmptySlotProps): unknown;
}>();
const wb = useWorkbench(props.workbenchKey);
const names = computed<WorkbenchLabels>(() => ({ ...DEFAULT_LABELS, ...props.labels }));
const hasFooter = computed(() => !!slots.footer);
const hasToolbar = computed(() => !!slots.toolbar);
// `#empty` (no items yet, wb.isEmpty): the host's empty state in the stage, with the Workbench's action descriptors and `act` to run one through the `action` event.
const emptyProps = computed<WorkbenchEmptySlotProps>(() => ({ actions: props.actions, act: (action: ActionDescriptor) => emit('action', action), label: names.value.stage }));

// The store follows the server: items, the reorder action and its version token, multi-select. The store lives per key across visits (pane prefs and zoom
// stay), but the selection is this page's: each mount starts from the server's `current` with no stage elements, and so does every change of `current`
// (a link, back, a visit that keeps this component).
wb.multiple = props.multiple;
wb.setItems(props.items);
// The attribute the stage's elements carry their id in, for the stage toolbar's selection rects; unset keeps the default (or a useWorkbench option).
watch(() => props.elementAttribute, name => { if (name) wb.setElementAttribute(name); }, { immediate: true });
watch(() => props.items, items => wb.setItems(items));
watch(() => [props.reorder, props.version] as const, ([action, token]) => wb.setReorder(action, token), { immediate: true });
function arrive(current: string | null): void {
    wb.clearElements();
    if (current !== null) wb.select(current, 'replace');
    else wb.clear();
}
arrive(props.current);
watch(() => props.current, arrive);

const store = createLayoutStore({ key: props.workbenchKey, state: props.layout?.state ?? null, preference: props.layout?.preference ?? null, changed: layout => { if (layout.zoom) wb.zoom = layout.zoom; } });
wb.attachLayout(store);
const splitter = store.splitter();
if (store.layout.tab && workbenchTabs(true).some(tab => tab.value === store.layout.tab)) wb.tab = store.layout.tab as WorkbenchRegion;
watch(() => wb.tab, tab => void store.update({ tab }));

// The mode follows the viewport (Tailwind's lg and xl), one live layout at a time.
let xl: MediaQueryList | undefined;
let lg: MediaQueryList | undefined;
const onMedia = () => { wb.mode = workbenchMode(xl?.matches ? 1280 : lg?.matches ? 1024 : 0); if (wb.mode !== 'drawer') wb.drawerOpen = false; applyDefaultCollapse(); };

const root = ref<HTMLElement>();
const navigator = ref<InstanceType<typeof WorkbenchNavigator>>();
const navigatorPanel = ref<InstanceType<typeof SplitterPanel>>();
const inspectorPanel = ref<InstanceType<typeof SplitterPanel>>();
// Each region's element id, for a collapsed pane's Expand button (`aria-controls`).
const uid = useId();
const regionId = (region: WorkbenchRegion) => `workbench-${uid}-${region}`;
const regionEl = (region: WorkbenchRegion) => root.value?.querySelector<HTMLElement>(`[data-workbench-region="${region}"]`) ?? null;
const toggle = (panel: InstanceType<typeof SplitterPanel> | undefined, region: WorkbenchRegion) => { if (!panel) return; if (wb.collapsed[region]) panel.expand(); else panel.collapse(); };

// navigator-mode="overlay" (the column layouts): the navigator is a sheet over the stage, never a column, so opening it never resizes the stage. The Modal gives the
// focus trap, Esc and focus back to the toggle; `close-on-select` closes it when an item is chosen. Below lg the tabs are unchanged.
const overlay = computed(() => props.navigatorMode === 'overlay' && wb.mode !== 'tabs');
const navigatorOpen = ref(false);
watch(() => wb.current, () => { if (overlay.value && props.closeOnSelect) navigatorOpen.value = false; });
// default-collapsed: each splitter group, the first time it shows, collapses the panes the host asks for unless the person has a remembered layout for it.
const defaulted = new Set<string>();
// `actions-bar` false drops the actions bar (its sticky row costs stage height on a dense surface); the host then drives the panes with useWorkbench().togglePane()
// and focusRegion(). With the headings off too, the bar was the panes' only toggle, so in development it warns if nothing has toggled a pane a few seconds in.
onMounted(() => {
    if (!import.meta.env?.DEV || props.actionsBar || props.headings) return;
    setTimeout(() => {
        if (wb.paneCalls === 0) console.warn(`<Workbench workbench-key="${props.workbenchKey}">: with headings and the actions bar off, the panes have no toggle of their own, and none has been toggled yet. Make sure your own controls call useWorkbench('${props.workbenchKey}').togglePane() or focusRegion() from your own controls.`);
    }, 3000);
});
function applyDefaultCollapse(): void {
    const group = wb.mode === 'columns' ? 'columns' : wb.mode === 'drawer' ? 'columns-lg' : null;
    if (group === null || defaulted.has(group)) return;
    defaulted.add(group);
    const regions = (wb.mode === 'columns' ? ['navigator', 'inspector'] : ['navigator']) as ('navigator' | 'inspector')[];
    void nextTick(() => {
        for (const region of defaultCollapses(props.defaultCollapsed, store.layout, group, regions)) {
            if (region === 'navigator' && overlay.value) continue;
            (region === 'navigator' ? navigatorPanel.value : inspectorPanel.value)?.collapse();
        }
    });
}

function focusRegion(region: WorkbenchRegion): void {
    if (wb.mode === 'tabs') wb.tab = region;
    if (region === 'inspector' && wb.mode === 'drawer') wb.drawerOpen = true;
    if (region === 'navigator' && overlay.value) navigatorOpen.value = true;
    else if (region === 'navigator' && wb.collapsed.navigator) navigatorPanel.value?.expand();
    void nextTick(() => {
        if (region === 'navigator' && (wb.current !== null || wb.isEmpty)) { navigator.value?.focusCurrent(); return; }
        const el = region === 'inspector' && wb.mode === 'drawer' ? document.querySelector<HTMLElement>('[data-workbench-region="inspector"]') : regionEl(region);
        el?.focus({ preventScroll: false });
    });
}
const activeRegion = (target: EventTarget | null): WorkbenchRegion | null => ((target as Element | null)?.closest?.('[data-workbench-region]')?.getAttribute('data-workbench-region') as WorkbenchRegion | null) ?? null;

function onKeydown(event: KeyboardEvent): void {
    const region = activeRegion(event.target);
    // `keys` false: a live session or transport owns the keyboard, so none of the Workbench's bindings fire (focus management and landmarks stay).
    const command = enabledCommand(props.keys, event, { inNavigator: region === 'navigator', typing: isTyping(event.target as HTMLElement | null), drawerOpen: wb.drawerOpen, elements: wb.elements.length > 0, selection: wb.selected.length > 0 });
    if (!command) return;
    event.preventDefault();
    switch (command) {
        case 'next': wb.next(); navigator.value?.focusCurrent(); break;
        case 'prev': wb.prev(); navigator.value?.focusCurrent(); break;
        case 'move-down': void wb.moveCurrent(1).then(() => navigator.value?.focusCurrent()); break;
        case 'move-up': void wb.moveCurrent(-1).then(() => navigator.value?.focusCurrent()); break;
        case 'collapse-navigator': wb.togglePane('navigator'); break;
        case 'collapse-inspector':
            if (wb.mode === 'drawer') wb.drawerOpen = !wb.drawerOpen;
            else wb.togglePane('inspector');
            break;
        case 'focus-filter': focusRegion('navigator'); void nextTick(() => navigator.value?.focusFilter()); break;
        case 'close-drawer': wb.drawerOpen = false; break;
        case 'clear-elements': wb.clearElements(); break;
        case 'clear-selection': wb.clear(); break;
        case 'next-region':
        case 'prev-region': {
            const order = regionOrder(wb.mode, { footer: hasFooter.value, collapsed: overlay.value ? { ...wb.collapsed, navigator: !navigatorOpen.value } : wb.collapsed, drawerOpen: wb.drawerOpen });
            const target = nextRegion(order, wb.mode === 'tabs' ? wb.tab : region, command === 'prev-region');
            if (target) focusRegion(target);
            break;
        }
        case 'zoom-in': wb.zoomIn(); break;
        case 'zoom-out': wb.zoomOut(); break;
        case 'zoom-reset': wb.zoomReset(); break;
    }
}

const cleanups: (() => void)[] = [];
onMounted(() => {
    xl = window.matchMedia('(min-width: 80rem)');
    lg = window.matchMedia('(min-width: 64rem)');
    onMedia();
    xl.addEventListener('change', onMedia);
    lg.addEventListener('change', onMedia);
    cleanups.push(wb.registerPane('navigator', () => { if (overlay.value) navigatorOpen.value = !navigatorOpen.value; else toggle(navigatorPanel.value, 'navigator'); }), wb.registerPane('inspector', () => toggle(inspectorPanel.value, 'inspector')));
    for (const region of ['navigator', 'stage', 'inspector', 'footer'] as const) cleanups.push(wb.registerFocus(region, () => focusRegion(region)));
    // Keys that work wherever focus is on the page (zoom, F6, collapsing panes); the rest stay inside the Workbench.
    document.addEventListener('keydown', onDocumentKeydown);
});
onBeforeUnmount(() => {
    xl?.removeEventListener('change', onMedia);
    lg?.removeEventListener('change', onMedia);
    document.removeEventListener('keydown', onDocumentKeydown);
    cleanups.forEach(cleanup => cleanup());
    wb.attachLayout(null);
});
function onDocumentKeydown(event: KeyboardEvent): void {
    if (event.defaultPrevented || root.value?.contains(event.target as Node)) return;
    const overlayOpen = !!document.querySelector('dialog[open]:not([data-workbench-drawer]), [role="dialog"]:not([data-workbench-drawer]), [role="menu"]');
    const active = document.activeElement;
    if (documentEscape({ key: event.key, typing: isTyping(event.target as HTMLElement | null) || isTyping(active as HTMLElement | null), activeIsBody: active === document.body || active === null, activeInWorkbench: !!active && !!root.value?.contains(active), overlayOpen })) {
        onKeydown(event);
        return;
    }
    if (overlayOpen) return;
    if (event.key === 'F6' || ((event.metaKey || event.ctrlKey) && ['[', ']', '=', '+', '-', '_', '0'].includes(event.key))) onKeydown(event);
}
const tabs = computed(() => workbenchTabs(hasFooter.value, names.value));
</script>
<template>
    <div ref="root" role="group" :aria-label="label" :class="['grid min-h-0 min-w-0 grid-rows-[minmax(0,1fr)_auto] gap-2', fill && 'h-[calc(100dvh-8rem)] min-h-[28rem]']" :data-workbench="workbenchKey" :data-mode="wb.mode" @keydown="onKeydown">
        <!-- xl and up: three columns. -->
        <SplitterGroup v-if="wb.mode === 'columns'" direction="horizontal" auto-save-id="columns" :storage="splitter" :keyboard-resize-by="5" class="min-h-0 min-w-0" data-workbench-columns>
            <template v-if="!overlay">
            <SplitterPanel id="navigator" ref="navigatorPanel" :default-size="20" :min-size="12" :max-size="35" collapsible :collapsed-size="0" class="min-h-0 min-w-0" @collapse="wb.collapsed.navigator = true" @expand="wb.collapsed.navigator = false">
                <nav :id="regionId('navigator')" :aria-label="names.navigator" tabindex="-1" class="flex h-full min-h-0 flex-col gap-1 focus-visible:outline-none" data-workbench-region="navigator">
                    <div v-if="headings" class="flex shrink-0 items-center justify-between gap-2"><h2 class="text-xs font-medium text-muted-foreground">{{ names.navigator }}</h2><PaneToggle :label="names.navigator" :collapsed="false" @click="wb.togglePane('navigator')" /></div>
                    <slot name="navigator"><WorkbenchNavigator ref="navigator" :workbench-key="workbenchKey" :label="names.navigator" :filterable="filterable" :reorderable="!!reorder" /></slot>
                </nav>
            </SplitterPanel>
            <WorkbenchCollapsedBar v-if="wb.collapsed.navigator" :label="names.navigator" :controls="regionId('navigator')" edge="side" @expand="wb.togglePane('navigator')" />
            <SplitterResizeHandle :aria-label="`Resize ${names.navigator.toLowerCase()} pane`" class="w-3 shrink-0 rounded focus-visible:bg-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"><span aria-hidden="true" class="mx-auto block h-full w-px bg-border" /></SplitterResizeHandle>
            </template>
            <SplitterPanel id="stage" :min-size="30" class="min-h-0 min-w-0">
                <section :aria-label="names.stage" tabindex="-1" class="h-full min-h-0 min-w-0 focus-visible:outline-none" data-workbench-region="stage">
                    <WorkbenchStage :workbench-key="workbenchKey" :storage="splitter" :footer="hasFooter" :toolbar="hasToolbar" :canvas="canvas" :stage-label="names.stage" :footer-label="names.footer">
                        <template v-if="hasToolbar" #toolbar><slot name="toolbar" /></template>
                        <template #stage><slot v-if="wb.isEmpty" name="empty" v-bind="emptyProps"><EmptyState :title="EMPTY_STAGE_TITLE" compact data-workbench-stage-empty /></slot><slot v-else name="stage" /></template>
                        <template v-if="hasFooter" #footer><slot name="footer" /></template>
                    </WorkbenchStage>
                </section>
            </SplitterPanel>
            <SplitterResizeHandle :aria-label="`Resize ${names.inspector.toLowerCase()} pane`" class="w-3 shrink-0 rounded focus-visible:bg-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"><span aria-hidden="true" class="mx-auto block h-full w-px bg-border" /></SplitterResizeHandle>
            <SplitterPanel id="inspector" ref="inspectorPanel" :default-size="26" :min-size="16" :max-size="45" collapsible :collapsed-size="0" class="min-h-0 min-w-0" @collapse="wb.collapsed.inspector = true" @expand="wb.collapsed.inspector = false">
                <aside :id="regionId('inspector')" :aria-label="names.inspector" tabindex="-1" class="flex h-full min-h-0 flex-col gap-1 focus-visible:outline-none" data-workbench-region="inspector">
                    <div v-if="headings" class="flex shrink-0 items-center justify-between gap-2"><h2 class="text-xs font-medium text-muted-foreground">{{ names.inspector }}</h2><PaneToggle :label="names.inspector" :collapsed="false" @click="wb.togglePane('inspector')" /></div>
                    <PaneScroll class="min-h-0 flex-1"><slot name="inspector"><WorkbenchInspector :workbench-key="workbenchKey" /></slot></PaneScroll>
                </aside>
            </SplitterPanel>
            <WorkbenchCollapsedBar v-if="wb.collapsed.inspector" :label="names.inspector" :controls="regionId('inspector')" edge="side" @expand="wb.togglePane('inspector')" />
        </SplitterGroup>

        <!-- lg: navigator and stage; the inspector in a right drawer. -->
        <template v-else-if="wb.mode === 'drawer'">
            <SplitterGroup direction="horizontal" auto-save-id="columns-lg" :storage="splitter" :keyboard-resize-by="5" class="min-h-0 min-w-0" data-workbench-columns-lg>
                <template v-if="!overlay">
                <SplitterPanel id="navigator" ref="navigatorPanel" :default-size="26" :min-size="15" :max-size="40" collapsible :collapsed-size="0" class="min-h-0 min-w-0" @collapse="wb.collapsed.navigator = true" @expand="wb.collapsed.navigator = false">
                    <nav :id="regionId('navigator')" :aria-label="names.navigator" tabindex="-1" class="flex h-full min-h-0 flex-col gap-1 focus-visible:outline-none" data-workbench-region="navigator">
                        <div v-if="headings" class="flex shrink-0 items-center justify-between gap-2"><h2 class="text-xs font-medium text-muted-foreground">{{ names.navigator }}</h2><PaneToggle :label="names.navigator" :collapsed="false" @click="wb.togglePane('navigator')" /></div>
                        <slot name="navigator"><WorkbenchNavigator ref="navigator" :workbench-key="workbenchKey" :label="names.navigator" :filterable="filterable" :reorderable="!!reorder" /></slot>
                    </nav>
                </SplitterPanel>
                <WorkbenchCollapsedBar v-if="wb.collapsed.navigator" :label="names.navigator" :controls="regionId('navigator')" edge="side" @expand="wb.togglePane('navigator')" />
                <SplitterResizeHandle :aria-label="`Resize ${names.navigator.toLowerCase()} pane`" class="w-3 shrink-0 rounded focus-visible:bg-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"><span aria-hidden="true" class="mx-auto block h-full w-px bg-border" /></SplitterResizeHandle>
                </template>
                <SplitterPanel id="stage" :min-size="40" class="min-h-0 min-w-0">
                    <section :aria-label="names.stage" tabindex="-1" class="h-full min-h-0 min-w-0 focus-visible:outline-none" data-workbench-region="stage">
                        <WorkbenchStage :workbench-key="workbenchKey" :storage="splitter" :footer="hasFooter" :toolbar="hasToolbar" :canvas="canvas" :stage-label="names.stage" :footer-label="names.footer">
                            <template v-if="hasToolbar" #toolbar><slot name="toolbar" /></template>
                            <template #stage><slot v-if="wb.isEmpty" name="empty" v-bind="emptyProps"><EmptyState :title="EMPTY_STAGE_TITLE" compact data-workbench-stage-empty /></slot><slot v-else name="stage" /></template>
                            <template v-if="hasFooter" #footer><slot name="footer" /></template>
                        </WorkbenchStage>
                    </section>
                </SplitterPanel>
            </SplitterGroup>
            <Modal v-model:open="wb.drawerOpen" :title="names.inspector" placement="drawer" size="md" data-workbench-drawer>
                <aside :aria-label="names.inspector" tabindex="-1" class="focus-visible:outline-none" data-workbench-region="inspector"><slot name="inspector"><WorkbenchInspector :workbench-key="workbenchKey" /></slot></aside>
            </Modal>
        </template>

        <!-- Below lg: one region at a time, behind tabs. -->
        <div v-else class="grid min-h-0 min-w-0 grid-rows-[auto_minmax(0,1fr)] gap-2" data-workbench-tabs>
            <PaneTabs :model-value="wb.tab" :tabs="tabs" :label="label" @update:model-value="value => (wb.tab = value as WorkbenchRegion)" />
            <nav v-show="wb.tab === 'navigator'" :aria-label="names.navigator" tabindex="-1" class="min-h-0 focus-visible:outline-none" data-workbench-region="navigator">
                <slot name="navigator"><WorkbenchNavigator ref="navigator" :workbench-key="workbenchKey" :label="names.navigator" :filterable="filterable" :reorderable="!!reorder" /></slot>
            </nav>
            <section v-show="wb.tab === 'stage'" :aria-label="names.stage" tabindex="-1" class="min-h-0 focus-visible:outline-none" data-workbench-region="stage">
                <WorkbenchStage :workbench-key="workbenchKey" :toolbar="hasToolbar" :canvas="canvas" :stage-label="names.stage" :footer-label="names.footer">
                    <template v-if="hasToolbar" #toolbar><slot name="toolbar" /></template>
                    <template #stage><slot v-if="wb.isEmpty" name="empty" v-bind="emptyProps"><EmptyState :title="EMPTY_STAGE_TITLE" compact data-workbench-stage-empty /></slot><slot v-else name="stage" /></template>
                </WorkbenchStage>
            </section>
            <aside v-show="wb.tab === 'inspector'" :aria-label="names.inspector" tabindex="-1" class="min-h-0 focus-visible:outline-none" data-workbench-region="inspector">
                <slot name="inspector"><WorkbenchInspector :workbench-key="workbenchKey" /></slot>
            </aside>
            <section v-if="hasFooter" v-show="wb.tab === 'footer'" :aria-label="names.footer" tabindex="-1" class="min-h-0 focus-visible:outline-none" data-workbench-region="footer">
                <slot name="footer" />
            </section>
        </div>

        <Modal v-if="overlay" v-model:open="navigatorOpen" :title="names.navigator" placement="slideover" size="md" data-workbench-drawer data-workbench-navigator-overlay>
            <nav :id="regionId('navigator')" :aria-label="names.navigator" tabindex="-1" class="focus-visible:outline-none" data-workbench-region="navigator">
                <slot name="navigator"><WorkbenchNavigator ref="navigator" :workbench-key="workbenchKey" :label="names.navigator" :filterable="filterable" :reorderable="!!reorder" /></slot>
            </nav>
        </Modal>

        <WorkbenchActions v-if="actionsBar" :workbench-key="workbenchKey" :actions="actions" :zoom="zoom" :save-status="saveStatus" :inspector-label="names.inspector" @action="emit('action', $event)">
            <template v-if="$slots.status" #status><slot name="status" /></template>
            <!-- Without the pane headings, or with an overlay navigator, the pane toggles live here, so every pane stays reachable by keyboard. -->
            <template v-if="wb.mode !== 'tabs' && (!headings || overlay)">
                <PaneToggle :label="names.navigator" :collapsed="overlay ? !navigatorOpen : wb.collapsed.navigator" data-workbench-pane-toggle="navigator" @click="wb.togglePane('navigator')" />
                <PaneToggle v-if="wb.mode === 'columns' && !headings" :label="names.inspector" :collapsed="wb.collapsed.inspector" data-workbench-pane-toggle="inspector" @click="wb.togglePane('inspector')" />
            </template>
            <slot name="actions" />
        </WorkbenchActions>
    </div>
</template>
