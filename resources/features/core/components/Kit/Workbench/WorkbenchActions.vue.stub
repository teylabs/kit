<script setup lang="ts">
import { computed } from 'vue';
import HeaderActions from '@/components/Kit/Action/HeaderActions.vue';
import type { ActionDescriptor } from '@/components/Kit/Action/actionPlacement';
import StickyBar from '@/components/Kit/Layout/StickyBar.vue';
import { SAVE_LABELS } from './workbench';
import { useWorkbench } from './useWorkbench';
import WorkbenchZoom from './WorkbenchZoom.vue';

/*
 * The Workbench's actions bar, a StickyBar (so it registers with useStickyBars and toasts stack clear of it): the save state (Saving… / Saved / Unsaved changes,
 * announced politely, the header status region), a conflict when the work changed elsewhere, the zoom controls, the inspector's opener at lg, and the app's
 * actions as kit action descriptors through HeaderActions (the page header's split, headerSplit: three or fewer with no `priority` stay ActionBar's, the first
 * filled, as before; more fold into a primary, two secondaries and More, only the primary below `sm`), so `Toast::success(...)->from('publish')` finds its trigger. Actions it does not navigate to are emitted. `save-status="none"`
 * leaves the save state and the conflict to the app (its own form bar's status in #actions): no kit status region renders, and `wb.saveState` is still there to read.
 */
const props = withDefaults(defineProps<{ workbenchKey: string; actions?: ActionDescriptor[]; zoom?: boolean; label?: string; inspectorLabel: string; conflictLabel?: string; saveStatus?: 'kit' | 'none' }>(), { saveStatus: 'kit', actions: () => [], zoom: false, label: 'Workbench actions', conflictLabel: 'Someone else changed this. Reload to see their version before you save again.' });
const emit = defineEmits<{ action: [action: ActionDescriptor] }>();
const wb = useWorkbench(props.workbenchKey);
const status = computed(() => (wb.saveState === 'idle' ? '' : SAVE_LABELS[wb.saveState]));
</script>
<template>
    <StickyBar :aria-label="label" role="region" class="col-span-full" data-workbench-actions>
        <p v-if="saveStatus === 'kit'" role="status" aria-live="polite" class="min-w-0 text-sm text-muted-foreground" :data-save-state="wb.saveState">{{ status }}</p>
        <p v-if="saveStatus === 'kit' && wb.saveState === 'conflict'" role="alert" class="min-w-0 text-sm font-medium text-destructive" data-workbench-conflict>{{ conflictLabel }}</p>
        <slot name="status" />
        <div class="ml-auto flex min-w-0 flex-wrap items-center justify-end gap-2">
            <WorkbenchZoom v-if="zoom" :workbench-key="workbenchKey" />
            <button v-if="wb.mode === 'drawer'" type="button" class="h-9 rounded-md border border-input bg-background px-3 text-sm font-medium shadow-xs hover:bg-accent" :aria-expanded="wb.drawerOpen" data-workbench-open-inspector @click="wb.drawerOpen = true">{{ inspectorLabel }}</button>
            <slot />
            <HeaderActions v-if="actions.length" :actions="actions" primary :busy="wb.saveState === 'saving'" @action="emit('action', $event)" />
        </div>
    </StickyBar>
</template>
