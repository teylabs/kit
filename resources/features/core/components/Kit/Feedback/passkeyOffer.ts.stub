// The passkey offer's browser side, on Fortify's own registration endpoints: fetch the creation options, let the browser create the credential, send it back.
// It uses the browser's own WebAuthn JSON helpers (PublicKeyCredential.parseCreationOptionsFromJSON and credential.toJSON()), so no client library is needed;
// a browser without them isn't offered a passkey at all.

type Credentials = { create: (options: { publicKey: unknown }) => Promise<{ toJSON: () => unknown } | null> };
type PublicKeyCredentialStatic = { parseCreationOptionsFromJSON?: (json: unknown) => unknown };
type Http = { request: (config: { method: string; url: string; data?: unknown; headers?: Record<string, string> }) => Promise<{ data: unknown }> };

export function passkeysSupported(scope: { PublicKeyCredential?: PublicKeyCredentialStatic; navigator?: { credentials?: Partial<Credentials> } } = globalThis as never): boolean {
    return typeof scope.PublicKeyCredential?.parseCreationOptionsFromJSON === 'function' && typeof scope.navigator?.credentials?.create === 'function';
}

/** A name for the passkey, so the person can tell their passkeys apart later: the device's platform, else "Passkey". */
export function passkeyName(platform: string | undefined): string {
    const name = (platform ?? '').trim();
    return name ? `${name} passkey` : 'Passkey';
}

/** Registers one passkey: options from `optionsUrl`, the browser's create(), then the credential to `storeUrl`. Throws when the person cancels or it fails. */
export async function registerPasskey(http: Http, urls: { options_url: string; store_url: string }, name: string, scope: { PublicKeyCredential: Required<PublicKeyCredentialStatic>; navigator: { credentials: Credentials } } = globalThis as never): Promise<void> {
    const response = await http.request({ method: 'get', url: urls.options_url, headers: { Accept: 'application/json' } });
    const options = (response.data as { options?: unknown }).options;
    const credential = await scope.navigator.credentials.create({ publicKey: scope.PublicKeyCredential.parseCreationOptionsFromJSON(options) });
    if (!credential) throw new Error('No passkey was created.');
    await http.request({ method: 'post', url: urls.store_url, data: { name, credential: credential.toJSON() }, headers: { Accept: 'application/json' } });
}
