<?php

use Composer\InstalledVersions;

// The installed package's defaults, wherever Composer put it.
$defaults = require InstalledVersions::getInstallPath('spatie/laravel-permission').'/config/permission.php';
$defaults['teams'] = true;
$defaults['column_names']['team_foreign_key'] = 'workspace_id';
$defaults['cache']['store'] = 'array';

return $defaults;
