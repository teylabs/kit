  "host_steps": {
    "legacy_table": [
      {
        "table": "notes",
        "why": "an earlier kit release kept notes there. The notes feature uses kit_notes and leaves that table alone; copy its notes with php artisan kit:notes:import --from=notes (idempotent; the source is never changed)."
      },
      {
        "table": "app_notes",
        "why": "the app kept its own notes there. The notes feature uses kit_notes and leaves that table alone; copy them with php artisan kit:notes:import --from=app_notes (idempotent; the source is never changed)."
      }
    ]
  }
